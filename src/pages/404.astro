---
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>404 · Marlon Guerra</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline src="/theme-init.js"></script>
  </head>
  <body>
    <main class="wrap nf mono">
      <p class="code">HTTP/1.1 <b>404</b> Not Found</p>
      <p class="dim">GET <span data-path>/</span></p>
      <p class="dim">The route does not exist in this cluster. · Esta ruta no existe en este clúster.</p>
      <p class="links"><a href="/es/">← /es/</a> <a href="/en/">← /en/</a></p>
    </main>
  </body>
</html>

<style>
  .nf {
    padding-top: 28vh;
    display: grid;
    gap: 10px;
    font-size: 14px;
  }
  .code {
    font-size: clamp(22px, 4vw, 34px);
    color: var(--ink);
  }
  .code b {
    color: var(--accent);
    font-weight: 500;
  }
  .dim {
    color: var(--muted);
  }
  .links {
    display: flex;
    gap: 20px;
    margin-top: 16px;
  }
</style>
