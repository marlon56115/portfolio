---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Lang } from '../i18n';
import { dict } from '../i18n';
import { sectionIndex } from '../lib/sections';
import SectionHead from './ui/SectionHead.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = dict[lang];
const p = t.projects;

// Capturas tomadas con datos de demostración (nunca datos reales).
const shots = import.meta.glob<{ default: ImageMetadata }>('../assets/projects/*.png', { eager: true });
const shotsFor = (prefix: string) =>
  Object.entries(shots)
    .filter(([path]) => {
      const file = path.split('/').pop() ?? '';
      return file.startsWith(`${prefix}-`) && !file.includes('mobile');
    })
    .sort(([a], [b]) => a.localeCompare(b))
    .map(([, mod]) => mod.default);

const prefix = { money: 'money', tickets: 'tickets' } as const;

const tree = [
  ['ansible/', lang === 'es' ? 'SO, discos, k3s, NAS' : 'OS, disks, k3s, NAS'],
  ['autoinstall/', 'cloud-init'],
  ['tofu/', lang === 'es' ? 'túnel, DNS, Access' : 'tunnel, DNS, Access'],
  ['k8s/', lang === 'es' ? 'GitOps con Flux' : 'GitOps with Flux'],
  ['  infra/', 'cnpg · garage · monitoring'],
  ['  apps/', lang === 'es' ? 'una carpeta por app' : 'one folder per app'],
  ['secrets/', 'sops + age'],
  ['docs/adr/', '34 ADR'],
  ['.github/workflows/', 'plan · check · apply'],
];
---

<section class="section" id="projects">
  <div class="wrap">
    <SectionHead index={sectionIndex('projects')} label={p.label} title={p.title} lead={p.lead} />

    <div class="projects">
      {
        p.items.map((item, idx) => {
          const imgs = item.slug === 'home-server' ? [] : shotsFor(prefix[item.slug]);
          return (
            <article class:list={['project', { featured: item.slug === 'home-server' }]} data-reveal>
              <div class="p-copy">
                <p class="p-kicker mono">
                  <span class="p-num">{String(idx + 1).padStart(2, '0')}</span>
                  {item.kicker}
                </p>
                <h3 class="p-name">
                  {item.name}
                  {item.slug === 'home-server' && (
                    <span class="here mono">
                      <span class="led is-pulse" /> {p.youAreHere}
                    </span>
                  )}
                </h3>
                <p class="p-summary">{item.summary}</p>
                <ul class="p-points">
                  {item.points.map((pt) => (
                    <li>{pt}</li>
                  ))}
                </ul>
                <ul class="chip-list">
                  {item.stack.map((s) => (
                    <li class="chip">{s}</li>
                  ))}
                </ul>
                <p class="p-status mono">
                  <span>{item.status}</span>
                  <span class="sep">·</span>
                  <span>{p.private}</span>
                </p>
              </div>

              <div class="p-visual">
                {item.slug === 'home-server' ? (
                  <div class="tree mono" aria-label="home-server/">
                    <p class="tree-head">
                      <span class="dots" aria-hidden="true">
                        <i />
                        <i />
                        <i />
                      </span>
                      ~/home-server <span class="branch">main</span>
                    </p>
                    <p class="tree-cmd">
                      <span>$</span> tree -L 2 --dirsfirst
                    </p>
                    <ul>
                      {tree.map(([dir, note]) => (
                        <li>
                          <span class="dir">{dir}</span>
                          <span class="note"># {note}</span>
                        </li>
                      ))}
                    </ul>
                    <p class="tree-cmd">
                      <span>$</span> make bootstrap <span class="note"># {lang === 'es' ? 'servidor limpio → todo de vuelta' : 'clean server → everything back'}</span>
                    </p>
                  </div>
                ) : (
                  imgs.length > 0 && (
                    <div class="gallery" data-gallery>
                      <div class="browser">
                        <p class="browser-bar" aria-hidden="true">
                          <span class="dots">
                            <i />
                            <i />
                            <i />
                          </span>
                          <span class="url mono">{item.slug === 'money' ? 'money.mihomeserver.com' : 'control-de-vales'} · demo</span>
                        </p>
                        <div class="screens">
                          {imgs.map((img, i) => (
                            <Image
                              src={img}
                              alt={`${item.name} — ${i + 1}`}
                              widths={[640, 960, 1440]}
                              sizes="(max-width: 860px) 92vw, 600px"
                              quality={80}
                              format="webp"
                              loading="lazy"
                              data-screen={i}
                              hidden={i !== 0}
                            />
                          ))}
                        </div>
                      </div>
                      {imgs.length > 1 && (
                        <div class="thumbs" role="group" data-js-only>
                          {imgs.map((img, i) => (
                            <button type="button" data-thumb={i} aria-pressed={i === 0 ? 'true' : 'false'} aria-label={`${item.name} ${i + 1}`}>
                              <Image src={img} alt="" widths={[160, 240]} sizes="96px" quality={60} format="webp" loading="lazy" />
                            </button>
                          ))}
                        </div>
                      )}
                    </div>
                  )
                )}
              </div>
            </article>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  .projects {
    display: grid;
    gap: clamp(56px, 8vw, 96px);
  }
  .project {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: clamp(28px, 5vw, 64px);
    align-items: start;
  }
  .project:nth-child(even) .p-copy {
    order: 2;
  }
  .p-kicker {
    display: flex;
    gap: 12px;
    font-size: 12px;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .p-num {
    color: var(--accent);
  }
  .p-name {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 16px;
    margin-top: 10px;
    font-size: clamp(26px, 3.4vw, 34px);
  }
  .here {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 4px 8px;
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0;
    color: var(--ok);
    border: 1px solid color-mix(in srgb, var(--ok) 35%, transparent);
    border-radius: 99px;
  }
  .p-summary {
    margin-top: 14px;
    color: var(--ink-2);
    font-size: 17px;
  }
  .p-points {
    list-style: none;
    display: grid;
    gap: 8px;
    margin: 20px 0 22px;
  }
  .p-points li {
    position: relative;
    padding-left: 18px;
    font-size: 15px;
    color: var(--ink-2);
  }
  .p-points li::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 0.72em;
    width: 7px;
    height: 1px;
    background: var(--accent);
  }
  .p-status {
    margin-top: 18px;
    font-size: 12px;
    color: var(--muted);
  }
  .sep {
    margin: 0 8px;
  }

  /* ---------- árbol del repo ---------- */
  .tree {
    padding: 0 0 18px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--term-bg);
    color: var(--term-ink);
    font-size: 13px;
    box-shadow: var(--shadow);
    overflow: hidden;
  }
  .tree-head,
  .browser-bar {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 14px;
    font-size: 12px;
    color: #8c919b;
    border-bottom: 1px solid #ffffff12;
  }
  .dots {
    display: inline-flex;
    gap: 6px;
  }
  .dots i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #ffffff22;
  }
  .branch {
    margin-left: auto;
    color: #4ac26b;
  }
  .tree-cmd {
    padding: 14px 18px 4px;
    color: #c3c1bb;
  }
  .tree-cmd > span:first-child {
    color: #f08a4b;
  }
  .tree ul {
    list-style: none;
    padding: 4px 18px 0;
  }
  .tree li {
    display: grid;
    grid-template-columns: 19ch minmax(0, 1fr);
    gap: 12px;
    padding: 3px 0;
    white-space: pre;
  }
  .dir {
    color: #e8e6e1;
  }
  .note {
    color: #6c717b;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* ---------- capturas ---------- */
  .browser {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow);
    overflow: hidden;
  }
  .browser-bar {
    color: var(--muted);
    border-bottom-color: var(--line);
    background: var(--surface-2);
  }
  .browser-bar .dots i {
    background: var(--line-strong);
  }
  .url {
    flex: 1;
    max-width: 260px;
    padding: 3px 10px;
    border-radius: 99px;
    background: var(--surface);
    font-size: 11px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .screens :global(img) {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top left;
  }
  .screens :global(img[hidden]) {
    display: none;
  }
  .thumbs {
    display: flex;
    gap: 8px;
    margin-top: 10px;
  }
  .thumbs button {
    width: 96px;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: none;
    cursor: pointer;
    overflow: hidden;
    opacity: 0.6;
    transition: opacity 0.15s, border-color 0.15s;
  }
  .thumbs button:hover,
  .thumbs button[aria-pressed='true'] {
    opacity: 1;
    border-color: var(--accent);
  }
  .thumbs :global(img) {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top left;
  }
  @media (max-width: 860px) {
    .project {
      grid-template-columns: minmax(0, 1fr); /* minmax(0,…): el árbol con white-space: pre no debe ensanchar la página */
    }
    .project:nth-child(even) .p-copy {
      order: 0;
    }
    .tree {
      font-size: 12px;
    }
  }
</style>
