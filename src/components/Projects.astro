---
// Proyectos propios: la plataforma (visual abstracto "reproducible desde git", sin detalles de
// infraestructura) y dos apps con galería de capturas (datos de demostración) y lightbox.
import type { Lang } from '../i18n';
import { dict } from '../i18n';
import { sectionIndex } from '../lib/sections';
import SectionHead from './ui/SectionHead.astro';
import LayerStack from './projects/LayerStack.astro';
import Gallery, { type Shot } from './projects/Gallery.astro';

import money1 from '../assets/projects/money-1.png';
import money2 from '../assets/projects/money-2.png';
import money3 from '../assets/projects/money-3.png';
import moneyDark from '../assets/projects/money-dark.png';
import moneyMobile from '../assets/projects/money-mobile.png';
import tickets1 from '../assets/projects/tickets-1.png';
import tickets2 from '../assets/projects/tickets-2.png';
import tickets3 from '../assets/projects/tickets-3.png';
import ticketsMobile from '../assets/projects/tickets-mobile.png';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const p = dict[lang].projects;

const galleries = {
  money: { host: 'gastos', imgs: [{ img: money1, dark: moneyDark }, { img: money2 }, { img: money3 }, { img: moneyMobile, phone: true }] },
  tickets: { host: 'control-de-vales', imgs: [{ img: tickets1 }, { img: tickets2 }, { img: tickets3 }, { img: ticketsMobile, phone: true }] },
};
const shotsFor = (slug: 'money' | 'tickets', captions: string[] = []): Shot[] =>
  galleries[slug].imgs.map((s, i) => ({ ...s, caption: captions[i] ?? `${slug} ${i + 1}` }));

const ui = { gallery: p.gallery, prev: p.prev, next: p.next, open: p.open, of: p.of, mobile: p.mobile, swipe: p.swipe };
---

<section class="section" id="projects">
  <div class="wrap">
    <SectionHead index={sectionIndex('projects')} label={p.label} title={p.title} lead={p.lead} />

    <div class="projects">
      {
        p.items.map((item, idx) => (
          <article class:list={['project', `project--${item.slug}`]} id={`project-${item.slug}`} data-reveal>
            <div class="p-copy">
              <p class="p-kicker label">
                <b>{String(idx + 1).padStart(2, '0')}</b>
                <span>{item.kicker}</span>
              </p>
              <h3 class="p-name">
                {item.name}
                {item.slug === 'platform' && (
                  <span class="here mono">
                    <span class="led is-pulse" /> {p.youAreHere}
                  </span>
                )}
              </h3>
              <p class="p-summary">{item.summary}</p>
              <ul class="p-points">
                {item.points.map((pt) => (
                  <li>{pt}</li>
                ))}
              </ul>
              <ul class="chip-list">
                {item.stack.map((s) => (
                  <li class="chip">{s}</li>
                ))}
              </ul>
              <p class="p-status mono">
                <span class="led led--ion" />
                <span>{item.status}</span>
                <span class="sep" aria-hidden="true">
                  ·
                </span>
                <span>{p.private}</span>
              </p>
            </div>

            <div class="p-visual">
              {item.slug === 'platform' ? (
                <LayerStack title={p.stack.title} run={p.stack.run} done={p.stack.done} layers={p.stack.layers} facts={p.stack.facts} />
              ) : (
                <Gallery name={item.name} host={galleries[item.slug].host} demo={p.demo} shots={shotsFor(item.slug, item.shots)} ui={ui} />
              )}
            </div>
          </article>
        ))
      }
    </div>
  </div>

  <!-- Lightbox compartido por las galerías (src/scripts/projects/lightbox.ts). -->
  <dialog class="lb" data-lightbox aria-label={p.gallery}>
    <div class="lb-bar">
      <p class="lb-count mono" data-lb-count></p>
      <button type="button" class="lb-btn" data-lb-close aria-label={p.close}><span aria-hidden="true">✕</span></button>
    </div>
    <div class="lb-stage" data-lb-stage>
      <img class="lb-img" data-lb-img alt="" decoding="async" />
    </div>
    <div class="lb-foot">
      <button type="button" class="lb-btn" data-lb-prev aria-label={p.prev}><span aria-hidden="true">←</span></button>
      <p class="lb-caption" data-lb-caption aria-live="polite"></p>
      <button type="button" class="lb-btn" data-lb-next aria-label={p.next}><span aria-hidden="true">→</span></button>
    </div>
  </dialog>
</section>

<style>
  .projects {
    display: grid;
    gap: clamp(64px, 9vw, 128px);
  }
  .project {
    display: grid;
    gap: var(--space-l);
    align-items: start;
  }
  .p-copy {
    display: grid;
    gap: var(--space-s);
    align-content: start;
  }
  .p-kicker {
    display: flex;
    gap: var(--space-xs);
  }
  .p-name {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2xs) var(--space-s);
    font-size: var(--step-4);
    font-weight: 600;
    letter-spacing: var(--track-display);
    line-height: 1;
  }
  .here {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    padding: 4px 10px;
    font-family: var(--font-mono);
    font-size: var(--step--2);
    font-weight: 400;
    letter-spacing: 0;
    color: var(--ok);
    border: 1px solid color-mix(in srgb, var(--ok) 40%, transparent);
  }
  .p-summary {
    max-width: var(--w-text);
    color: var(--ink-2);
    font-size: var(--step-1);
    line-height: 1.5;
  }
  .p-points {
    list-style: none;
    display: grid;
    gap: var(--space-2xs);
    margin: var(--space-2xs) 0;
  }
  .p-points li {
    position: relative;
    padding-left: 20px;
    color: var(--ink-2);
    max-width: var(--w-text);
  }
  .p-points li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.72em;
    width: 9px;
    height: 1px;
    background: var(--volt-ink);
  }
  .p-status {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2xs);
    font-size: var(--step--2);
    color: var(--muted);
  }
  .p-status .led {
    margin-right: 4px;
  }
  .p-visual {
    min-width: 0;
  }

  @media (min-width: 1024px) {
    .project {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: var(--space-2xl);
    }
    .project:nth-child(even) .p-copy {
      order: 2;
    }
    .p-visual {
      position: sticky;
      top: calc(var(--header-h) + var(--space-l));
    }
  }

  /* ---------- lightbox ---------- */
  .lb {
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: color-mix(in srgb, var(--bg) 94%, transparent);
    color: var(--ink);
  }
  .lb[open] {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
  }
  .lb::backdrop {
    background: rgb(0 0 0 / 0.6);
  }
  .lb-bar,
  .lb-foot {
    display: flex;
    align-items: center;
    gap: var(--space-s);
    padding: var(--space-xs) var(--gutter);
  }
  .lb-bar {
    justify-content: space-between;
    border-bottom: 1px solid var(--line);
  }
  .lb-foot {
    border-top: 1px solid var(--line);
  }
  .lb-count {
    font-size: var(--step--1);
    color: var(--ion-ink);
  }
  .lb-caption {
    flex: 1;
    text-align: center;
    color: var(--ink-2);
    font-size: var(--step--1);
  }
  .lb-btn {
    display: grid;
    place-items: center;
    flex: none;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1px solid var(--line-strong);
    background: var(--surface);
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 16px;
    cursor: pointer;
  }
  .lb-btn:hover {
    border-color: var(--ion);
    color: var(--ion-ink);
  }
  .lb-stage {
    display: grid;
    place-items: center;
    min-height: 0;
    padding: var(--space-s) var(--gutter);
    touch-action: pan-y;
  }
  .lb-img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    border: 1px solid var(--line-strong);
    box-shadow: var(--shadow-2);
    transition: opacity var(--dur-2) var(--ease-out);
  }
  .lb-img.is-loading {
    opacity: 0.3;
  }
</style>
