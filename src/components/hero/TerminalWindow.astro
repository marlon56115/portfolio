---
// Terminal integrada en el hero. El HTML trae ya la transcripción de la intro (whoami + skills --top):
// sin JS se lee igual; con JS, src/scripts/terminal.ts la vuelve a "teclear" y deja el prompt listo.
// Toda la salida dinámica se construye con nodos + textContent (Trusted Types).
import type { Lang } from '../../i18n';
import { dict } from '../../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = dict[lang];
const s = t.terminal;
const p = s.prompt;
const chips = ['help', 'whoami', 'skills --top', 'focus ai', 'experience', 'projects', 'contact', 'status', 'neofetch', 'clear'];
const pad = (v: string, n: number) => v.padEnd(n, ' ');
---

<div class="term" data-terminal role="region" aria-label={`${s.title} · ${s.simNote}`}>
  <div class="term__bar">
    <span class="term__dots" aria-hidden="true"><i></i><i></i><i></i></span>
    <span class="term__title">{p.user}@{p.host}: {p.path}</span>
    <span class="term__status"><span class="led is-pulse" data-hero-led></span><span data-hero-status>{s.nf.hostValue}</span></span>
  </div>

  <div class="term__out is-pending" data-terminal-out role="log" aria-live="polite">
    <div class="r"><span class="c-dim">{s.welcome}</span></div>
    <div class="r" data-cmd><span class="c-ok">{p.user}@{p.host}</span><span class="c-dim">:{p.path}$ </span><span class="c-cmd">whoami</span></div>
    <div class="r"><span class="c-ok">{t.name}</span><span class="c-dim"> — </span>{t.hero.title}</div>
    <div class="r"><span class="c-dim">{t.location}</span></div>
    <div class="r" data-cmd><span class="c-ok">{p.user}@{p.host}</span><span class="c-dim">:{p.path}$ </span><span class="c-cmd">skills --top</span></div>
    {
      t.hero.capabilities.map((c, i) => (
        <div class="r" data-ch={c.k}>
          <span class="c-dim">{`CH${i + 1} `}</span>
          <span class="c-acc">{pad(c.k, 7)}</span>
          {c.tools.join(' · ')}
        </div>
      ))
    }
  </div>

  <form class="term__line" data-terminal-form data-js-only autocomplete="off">
    <label class="term__prompt" for="term-in"><span class="term__who"><span class="u">{p.user}</span>@<span class="h">{p.host}</span>:</span><span class="p">{p.path}</span>$</label>
    <span class="term__typed" data-terminal-typed aria-hidden="true"></span><span class="term__caret" aria-hidden="true"></span>
    <input
      id="term-in"
      class="term__in"
      data-terminal-in
      type="text"
      aria-label={s.inputLabel}
      spellcheck="false"
      autocapitalize="off"
      autocomplete="off"
      maxlength="120"
      enterkeyhint="send"
    />
  </form>

  <div class="term__chips" data-js-only role="toolbar" aria-label={s.chipsLabel}>
    {chips.map((c) => <button type="button" class="term__chip" data-cmd={c}>{c}</button>)}
  </div>

  <p class="term__note"><span class="term__sim" aria-hidden="true">sim</span>{s.simNote}</p>
</div>

<style>
  .term {
    --t-line: rgb(214 224 232 / 0.1);
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    min-width: 0;
    color: var(--term-ink);
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.6;
    filter: drop-shadow(0 24px 40px rgb(0 0 0 / 0.35));
  }
  /* borde + fondo achaflanados en pseudos (no recortan el foco de los controles) */
  .term::before,
  .term::after {
    content: '';
    position: absolute;
    z-index: -1;
    clip-path: polygon(0 0, calc(100% - var(--cut)) 0, 100% var(--cut), 100% 100%, var(--cut) 100%, 0 calc(100% - var(--cut)));
  }
  .term::before {
    inset: 0;
    background: linear-gradient(160deg, color-mix(in srgb, var(--volt) 55%, transparent), rgb(214 224 232 / 0.14) 30%, rgb(214 224 232 / 0.14));
  }
  .term::after {
    inset: 1px;
    background: var(--term-bg);
  }
  .term:focus-within::before {
    background: linear-gradient(160deg, var(--volt), color-mix(in srgb, var(--ion) 50%, transparent) 45%, rgb(214 224 232 / 0.2));
  }

  .term__bar {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 36px;
    padding: 0 14px;
    border-bottom: 1px solid var(--t-line);
    color: var(--term-dim);
    font-size: 12px;
  }
  .term__dots {
    display: inline-flex;
    gap: 5px;
  }
  .term__dots i {
    width: 7px;
    height: 7px;
    background: rgb(214 224 232 / 0.18);
  }
  .term__dots i:first-child {
    background: var(--volt);
  }
  .term__title {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .term__status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    white-space: nowrap;
    font-size: 11px;
  }
  .term__status .led {
    --led: #5be38a;
  }
  .term__status .led.is-off {
    --led: var(--term-dim);
  }

  .term__out {
    flex: none;
    height: var(--term-h, 232px);
    overflow-y: auto;
    padding: 12px 14px 4px;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    scrollbar-color: rgb(214 224 232 / 0.2) transparent;
    scrollbar-width: thin;
    overscroll-behavior: contain;
  }
  /* Intro pendiente: con JS y movimiento, la transcripción se oculta hasta que terminal.ts la reescribe.
     Si el script fallara, la animación de respaldo la muestra a los 2.5 s. */
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .term__out.is-pending > :global(*) {
      opacity: 0;
      animation: term-fallback 0s 2.5s forwards;
    }
  }
  @keyframes term-fallback {
    to {
      opacity: 1;
    }
  }
  .term__out :global(.r) {
    min-height: 1.6em;
    transition: background-color var(--dur-1) var(--ease-out);
  }
  .term__out :global(.c-cmd) {
    color: #f1f5f8;
  }
  .term__out :global(.c-dim) {
    color: var(--term-dim);
  }
  .term__out :global(.c-acc) {
    color: #c8ff3d;
  }
  .term__out :global(.c-ok) {
    color: #5be38a;
  }
  .term__out :global(.c-warn) {
    color: #ffc93d;
  }
  .term__out :global(.c-err) {
    color: #ff5c7a;
  }
  .term__out :global(.c-blue) {
    color: #38e1ff;
  }
  .term__out :global(a) {
    color: #38e1ff;
    text-underline-offset: 3px;
  }
  /* El canal activo del hero ilumina sus líneas en la salida. */
  .term__out[data-hl='dev'] :global([data-ch='dev']),
  .term__out[data-hl='deploy'] :global([data-ch='deploy']),
  .term__out[data-hl='infra'] :global([data-ch='infra']),
  .term__out[data-hl='data'] :global([data-ch='data']),
  .term__out[data-hl='ai'] :global([data-ch='ai']) {
    background: rgb(200 255 61 / 0.1);
    box-shadow: inset 2px 0 0 #c8ff3d;
  }

  .term__line {
    display: flex;
    align-items: center;
    min-height: 40px;
    padding: 0 14px;
    cursor: text;
  }
  .term__prompt {
    flex: none;
    margin-right: 8px;
    white-space: nowrap;
    color: var(--term-dim);
  }
  .u {
    color: #5be38a;
  }
  .h {
    color: #c8ff3d;
  }
  .p {
    color: #38e1ff;
  }
  .term__typed {
    white-space: pre;
    color: #f1f5f8;
  }
  .term__caret {
    display: none;
    flex: none;
    width: 0.6em;
    height: 1.15em;
    background: #c8ff3d;
    animation: caret 1.05s steps(1) infinite;
  }
  .term__line.is-idle .term__caret {
    display: inline-block;
  }
  @keyframes caret {
    50% {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .term__caret {
      animation: none;
    }
  }
  .term__in {
    flex: 1;
    min-width: 0;
    height: 44px;
    padding: 0;
    border: 0;
    outline: 0;
    background: transparent;
    color: #f1f5f8;
    font: inherit;
    font-size: 16px; /* 16 px: iOS no hace zoom al enfocar */
    caret-color: #c8ff3d;
  }
  .term__line.is-idle .term__in {
    caret-color: transparent;
  }

  .term__chips {
    display: flex;
    gap: 6px;
    padding: 6px 14px 10px;
    overflow-x: auto;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
    mask-image: linear-gradient(90deg, #000 calc(100% - 28px), transparent);
  }
  .term__chips::-webkit-scrollbar {
    display: none;
  }
  .term__chip {
    flex: none;
    min-height: 44px;
    padding: 0 12px;
    border: 1px solid rgb(214 224 232 / 0.16);
    border-radius: var(--radius);
    background: rgb(214 224 232 / 0.04);
    color: var(--term-ink);
    font: inherit;
    font-size: 12px;
    white-space: nowrap;
    cursor: pointer;
    transition:
      border-color var(--dur-1) var(--ease-out),
      color var(--dur-1) var(--ease-out);
  }
  .term__chip::before {
    content: '$ ';
    color: var(--term-dim);
  }
  .term__chip:hover {
    border-color: #c8ff3d;
    color: #c8ff3d;
  }
  .term__chip:focus-visible {
    outline: 2px solid #38e1ff;
    outline-offset: -2px;
  }
  @media (pointer: fine) {
    .term__chip {
      min-height: 30px;
    }
  }

  .term__note {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    padding: 8px 14px 10px;
    border-top: 1px solid var(--t-line);
    color: var(--term-dim);
    font-size: 11px;
    line-height: 1.4;
  }
  .term__sim {
    flex: none;
    padding: 1px 5px;
    border: 1px solid rgb(56 225 255 / 0.5);
    color: #38e1ff;
    font-family: var(--font-display);
    font-size: 10px;
    font-stretch: 87.5%;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  @media (max-width: 419.98px) {
    .term__who {
      display: none;
    }
    .term__status [data-hero-status] {
      display: none;
    }
  }
</style>
