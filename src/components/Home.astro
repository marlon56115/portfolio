---
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Hero from './Hero.astro';
import System from './System.astro';
import Work from './Work.astro';
import Projects from './Projects.astro';
import Skills from './Skills.astro';
import Contact from './Contact.astro';
import Terminal from './Terminal.astro';
import type { Lang } from '../i18n/content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
// Los pone el Dockerfile al construir; en local se ven como "dev".
const version = process.env.BUILD_VERSION || 'dev';
const commit = process.env.BUILD_COMMIT || '0000000';
---

<Base lang={lang}>
  <Header lang={lang} />
  <main id="main">
    <Hero lang={lang} />
    <System lang={lang} />
    <Work lang={lang} />
    <Projects lang={lang} />
    <Skills lang={lang} />
    <Contact lang={lang} version={version} commit={commit} />
  </main>
  <Terminal lang={lang} />
</Base>

<script>
  import '../scripts/main';
</script>
