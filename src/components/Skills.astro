---
import type { Lang } from '../i18n';
import { dict } from '../i18n';
import { sectionIndex } from '../lib/sections';
import SectionHead from './ui/SectionHead.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = dict[lang].skills;
---

<section class="section" id="skills">
  <div class="wrap">
    <SectionHead index={sectionIndex('skills')} label={s.label} title={s.title} lead={s.lead} />

    <div class="grid">
      <dl class="table" data-reveal>
        {
          s.groups.map((g) => (
            <div class="row">
              <dt class="mono">{g.t}</dt>
              <dd>
                <ul class="chip-list">
                  {g.v.map((v) => (
                    <li class="chip">{v}</li>
                  ))}
                </ul>
              </dd>
            </div>
          ))
        }
      </dl>

      <aside class="side" data-reveal>
        <h3 class="side-t mono">{s.eduTitle}</h3>
        <ul class="edu">
          {
            s.edu.map((e) => (
              <li>
                <p class="edu-t">{e.t}</p>
                <p class="edu-s mono">{e.s}</p>
                {e.n && <p class="edu-n">{e.n}</p>}
              </li>
            ))
          }
        </ul>
        <h3 class="side-t mono">{s.certTitle}</h3>
        <ul class="certs">
          {s.certs.map((c) => <li>{c}</li>)}
        </ul>
      </aside>
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
    gap: clamp(32px, 5vw, 64px);
  }
  .table {
    margin: 0;
    border-top: 1px solid var(--line);
  }
  .row {
    display: grid;
    grid-template-columns: 150px minmax(0, 1fr);
    gap: 16px;
    padding: 16px 0;
    border-bottom: 1px solid var(--line);
  }
  .row dt {
    padding-top: 4px;
    font-size: 12px;
    color: var(--muted);
    text-transform: lowercase;
  }
  .row dd {
    margin: 0;
  }
  .side-t {
    font-size: 12px;
    font-weight: 500;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 14px;
  }
  .edu {
    list-style: none;
    display: grid;
    gap: 18px;
    margin-bottom: 36px;
  }
  .edu li {
    padding-left: 14px;
    border-left: 1px solid var(--line-strong);
  }
  .edu li:first-child {
    border-left-color: var(--accent);
  }
  .edu-t {
    font-weight: 500;
  }
  .edu-s {
    margin-top: 2px;
    font-size: 12px;
    color: var(--muted);
  }
  .edu-n {
    margin-top: 4px;
    font-size: 14px;
    color: var(--ink-2);
  }
  .certs {
    list-style: none;
    display: grid;
    gap: 6px;
    font-size: 14px;
    color: var(--ink-2);
  }
  @media (max-width: 860px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 520px) {
    .row {
      grid-template-columns: 1fr;
      gap: 8px;
    }
  }
</style>
