---
// Sección 04 "autoalojado".
// Panel en vivo (/api/status) + dos flujos interactivos (camino de una petición y cómo sale una
// versión) + caja de herramientas. Todo genérico a propósito (DESIGN.md §7): etapas abstractas,
// sin nombres internos, versiones ni detalles de red.
// Comportamiento en src/scripts/sections/system.ts. Sin JS: cifras en "—" con una nota, y todas las
// descripciones de las etapas visibles como lista.
import type { Lang } from '../i18n';
import { dict } from '../i18n';
import { sectionIndex } from '../lib/sections';
import SectionHead from './ui/SectionHead.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = dict[lang].system;
const L = s.live;
const n2 = (i: number) => String(i + 1).padStart(2, '0');

const flows = [
  { key: 'path', data: s.path, initial: 'service' },
  { key: 'ship', data: s.ship, initial: 'ci' },
] as const;
---

<section class="section sys" id="system" aria-labelledby="system-title">
  <div class="wrap">
    <SectionHead index={sectionIndex('system')} label={s.label} title={s.title} lead={s.lead} id="system-title" />

    <div class="sys-grid">
      <!-- ---------- panel en vivo ---------- -->
      <div class="live-col">
        <div class="panel panel--raised live" data-status-panel data-state="connecting" data-reveal>
          <div class="panel__bar">
            <span class="led is-off" data-status-led></span>
            <span class="panel__title">{L.title}</span>
            <span class="live-state" data-status-state role="status">{L.connecting}</span>
          </div>

          <div class="live-grid">
            <div class="metric metric--cpu" data-tile="cpu">
              <div class="metric-head">
                <p class="metric-k">{L.cpu}</p>
                <p class="metric-v"><span data-metric="cpu">—</span><small aria-hidden="true">%</small></p>
                <p class="metric-n" data-note="cpu" data-note-on={L.cpuNote} data-note-idle={L.idleNote}>{L.cpuNote}</p>
              </div>
              <div class="spark" aria-hidden="true">
                <svg viewBox="0 0 240 64" preserveAspectRatio="none" data-spark>
                  <line class="spark-grid" x1="0" y1="16" x2="240" y2="16"></line>
                  <line class="spark-grid" x1="0" y1="32" x2="240" y2="32"></line>
                  <line class="spark-grid" x1="0" y1="48" x2="240" y2="48"></line>
                  <line class="spark-flat" x1="0" y1="62" x2="240" y2="62"></line>
                  <path class="spark-area" d=""></path>
                  <path class="spark-line" d=""></path>
                </svg>
                <span class="spark-scan"></span>
              </div>
            </div>

            <div class="metric" data-tile="memory">
              <p class="metric-k">{L.memory}</p>
              <p class="metric-v"><span data-metric="memory">—</span><small aria-hidden="true">%</small></p>
              <span class="gauge" aria-hidden="true"><span data-gauge="memory"></span></span>
              <p class="metric-n" data-note="memory" data-note-on={L.memoryNote} data-note-idle={L.idleNote}>{L.memoryNote}</p>
            </div>

            <div class="metric" data-tile="latency">
              <p class="metric-k">{L.latency}</p>
              <p class="metric-v"><span data-metric="latency">—</span><small aria-hidden="true">ms</small></p>
              <p class="metric-n">{L.latencyNote}</p>
            </div>

            <div class="metric" data-tile="uptime">
              <p class="metric-k">{L.uptime}</p>
              <p class="metric-v"><span data-metric="uptime">—</span></p>
              <p class="metric-n">{L.uptimeNote}</p>
            </div>

            <div class="metric" data-tile="requests">
              <p class="metric-k">{L.requests}</p>
              <p class="metric-v"><span data-metric="requests">—</span></p>
              <p class="metric-n">{L.requestsNote}</p>
            </div>
          </div>

          <p class="live-foot">
            <span>{L.foot}</span>
            <span class="live-time" data-status-time></span>
          </p>
          <p class="live-nojs">{L.noscript}</p>
        </div>
      </div>

      <!-- ---------- flujos ---------- -->
      <div class="flows">
        {
          flows.map((f) => (
            <figure class={`flow flow--${f.key}`} data-flow={f.key} data-reveal aria-labelledby={`flow-${f.key}-t`}>
              <figcaption class="flow-head">
                <h3 class="flow-t" id={`flow-${f.key}-t`}>
                  <span class="flow-i" aria-hidden="true">
                    {f.key === 'path' ? 'A' : 'B'}
                  </span>
                  {f.data.title}
                </h3>
              </figcaption>

              <div class={`stages stages--${f.data.stages.length}`}>
                {f.data.stages.map((st, i) => (
                  <>
                    {i > 0 && (
                      <span class="wire" aria-hidden="true">
                        <i />
                      </span>
                    )}
                    <button
                      class="stage"
                      type="button"
                      data-stage={st.id}
                      aria-pressed={st.id === f.initial ? 'true' : 'false'}
                      aria-controls={`flow-${f.key}-detail`}
                    >
                      <span class="stage-n" aria-hidden="true">
                        {n2(i)}
                      </span>
                      <span class="stage-t">{st.t}</span>
                      <span class="stage-m">{st.meta}</span>
                      <span class="stage-led" aria-hidden="true" />
                      <span class="stage-ping" aria-hidden="true" />
                    </button>
                  </>
                ))}
              </div>

              {f.key === 'path' && (
                <p class="ping" data-ping data-js-only>
                  <span class="led led--ion is-off" data-ping-led />
                  <span>{s.path.ping}</span>
                  <b data-ping-ms>—</b>
                </p>
              )}

              <div class="readout" id={`flow-${f.key}-detail`} aria-live="polite">
                {f.data.stages.map((st, i) => (
                  <div class:list={['readout-item', { 'is-on': st.id === f.initial }]} data-detail={st.id}>
                    <p class="readout-k">
                      <span aria-hidden="true">{n2(i)}</span> {st.t}
                    </p>
                    <p class="readout-d">{st.d}</p>
                  </div>
                ))}
              </div>
            </figure>
          ))
        }
      </div>
    </div>

    <!-- ---------- caja de herramientas ---------- -->
    <div class="toolbox" data-reveal>
      <p class="label">{s.toolbox.title}</p>
      <ul class="chip-list">
        {s.toolbox.items.map((t, i) => <li class:list={['chip', { 'chip--volt': i < 3 }]}>{t}</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  /* =================== maquetación =================== */
  .sys-grid {
    display: grid;
    gap: var(--space-l);
    margin-top: var(--space-xl);
  }
  @media (min-width: 1024px) {
    .sys-grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: var(--space-xl);
      align-items: start;
    }
    .live {
      position: sticky;
      top: calc(var(--header-h) + var(--space-m));
    }
  }

  /* =================== panel en vivo =================== */
  .live-state {
    flex: none;
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0;
    text-transform: none;
    color: var(--muted);
  }
  .live[data-state='online'] .live-state {
    color: var(--ok);
  }
  .live[data-state='offline'] .live-state {
    color: var(--warn);
  }
  .live-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .metric {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
    min-width: 0;
    padding: var(--space-s);
    border-bottom: 1px solid var(--line);
  }
  /* CPU ocupa la fila entera; las otras cuatro van de dos en dos. */
  .metric--cpu {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-xs);
  }
  .metric:nth-child(odd):not(.metric--cpu) {
    border-left: 1px solid var(--line);
  }
  .metric:nth-child(even) {
    border-left: 0;
  }
  .metric:nth-last-child(-n + 2) {
    border-bottom: 0;
  }
  .metric-k {
    font-family: var(--font-display);
    font-size: var(--step--2);
    font-stretch: 87.5%;
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--muted);
  }
  .metric-v {
    display: flex;
    align-items: baseline;
    gap: 0.2em;
    font-family: var(--font-mono);
    font-size: clamp(26px, 6.4vw, 34px);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
    color: var(--ink);
    transition: color var(--dur-2) var(--ease-out), opacity var(--dur-2) var(--ease-out);
  }
  .metric-v small {
    font-size: 0.5em;
    letter-spacing: 0;
    color: var(--muted);
  }
  .metric-n {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--muted);
  }
  .metric[data-idle] .metric-v {
    color: var(--muted);
  }
  .live[data-state='offline'] .metric-v,
  .live[data-state='connecting'] .metric-v {
    opacity: 0.55;
  }

  /* sparkline */
  .spark {
    position: relative;
    height: 64px;
    overflow: hidden;
  }
  .spark svg {
    display: block;
    width: 100%;
    height: 100%;
  }
  .spark-grid {
    stroke: var(--line);
    stroke-width: 1;
    stroke-dasharray: 2 4;
    vector-effect: non-scaling-stroke;
  }
  .spark-flat {
    stroke: var(--line-strong);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }
  .spark-line {
    fill: none;
    stroke: var(--ion);
    stroke-width: 1.5;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }
  .spark-area {
    fill: var(--ion-soft);
  }
  /* Sin datos de carga: una línea plana y un barrido, como un osciloscopio esperando señal. */
  .spark-scan {
    position: absolute;
    inset: 0;
    display: none;
    background: linear-gradient(90deg, transparent 0 82%, var(--ion-soft) 96%, var(--ion) 99.5%, transparent 100%);
    opacity: 0.7;
  }
  .metric[data-idle] .spark-scan {
    display: block;
    animation: scan 3.2s linear infinite;
  }
  .metric[data-idle] .spark-area,
  .metric[data-idle] .spark-line {
    display: none;
  }
  @keyframes scan {
    from {
      transform: translateX(-100%);
    }
    to {
      transform: translateX(100%);
    }
  }

  /* barra segmentada de memoria */
  .gauge {
    position: relative;
    display: block;
    height: 8px;
    margin: var(--space-3xs) 0 2px;
    background: var(--surface-3);
    overflow: hidden;
  }
  .gauge span {
    position: absolute;
    inset: 0;
    background: var(--ion);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-4) var(--ease-out);
  }
  .gauge::after {
    content: '';
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(90deg, transparent 0 calc(5% - 2px), var(--surface-2) calc(5% - 2px) 5%);
  }

  .live-foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-3xs) var(--space-s);
    padding: var(--space-xs) var(--space-s);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--muted);
  }
  .live-nojs {
    display: none;
    padding: 0 var(--space-s) var(--space-s);
    font-size: var(--step--1);
    color: var(--ink-2);
  }
  :global(html:not(.js)) .live-nojs {
    display: block;
  }

  /* =================== flujos =================== */
  .flows {
    display: grid;
    gap: var(--space-l);
    min-width: 0;
  }
  .flow {
    container-type: inline-size;
    margin: 0;
    min-width: 0;
  }
  .flow-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3xs) var(--space-m);
    margin-bottom: var(--space-s);
  }
  .flow-t {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-stretch: 87.5%;
    font-weight: 600;
    letter-spacing: -0.03em;
  }
  .flow-i {
    display: inline-grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border: 1px solid var(--line-strong);
    font-size: var(--step--2);
    letter-spacing: 0;
    color: var(--volt-ink);
  }
  .flow-lead {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--muted);
  }

  /* ---- etapas: vertical por defecto (teléfono), horizontal si el contenedor da ---- */
  .stages {
    --packet: var(--fx-hot);
    --wire-len: 26px;
    --cycle: 4.2s;
    --hop: 0.6s;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }
  .stage {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-xs);
    min-height: 56px;
    padding: var(--space-xs) var(--space-s);
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--ink);
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition:
      border-color var(--dur-1) var(--ease-out),
      background-color var(--dur-1) var(--ease-out),
      translate var(--dur-2) var(--ease-out);
  }
  .stage:hover {
    border-color: var(--line-strong);
    background: var(--surface-2);
  }
  .stage[aria-pressed='true'] {
    border-color: var(--volt-ink);
    background: color-mix(in srgb, var(--volt-soft) 100%, var(--surface));
  }
  .stage-n {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--muted);
  }
  .stage[aria-pressed='true'] .stage-n {
    color: var(--volt-ink);
  }
  .stage-t {
    font-family: var(--font-display);
    font-size: var(--step--1);
    font-stretch: 87.5%;
    font-weight: 600;
    letter-spacing: -0.02em;
    overflow-wrap: anywhere;
  }
  .stage-m {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--muted);
    white-space: nowrap;
  }
  /* LED de la etapa: se enciende cuando llega el paquete. */
  .stage-led {
    position: absolute;
    top: -1px;
    right: -1px;
    width: 6px;
    height: 6px;
    background: var(--packet);
    opacity: 0.18;
  }
  /* Destello del ping real (lo anima system.ts con la Web Animations API, solo opacidad). */
  .stage-ping {
    position: absolute;
    inset: -1px;
    border: 1px solid var(--ion);
    box-shadow: 0 0 0 3px var(--ion-soft);
    opacity: 0;
    pointer-events: none;
  }

  .wire {
    position: relative;
    display: block;
    height: var(--wire-len);
    margin-left: calc(var(--space-s) + 0.6em);
    width: 7px;
  }
  .wire::before {
    content: '';
    position: absolute;
    left: 3px;
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--line-strong);
  }
  .wire i {
    position: absolute;
    left: 0;
    top: 0;
    width: 7px;
    height: 7px;
    background: var(--packet);
    box-shadow: 0 0 8px var(--packet);
    opacity: 0;
    --travel: translateY(calc(var(--wire-len) - 7px));
  }

  @container (min-width: 520px) {
    .stages--4 {
      grid-template-columns: minmax(0, 1fr) repeat(3, var(--wire-len) minmax(0, 1fr));
    }
    .stages--5 {
      grid-template-columns: minmax(0, 1fr) repeat(4, var(--wire-len) minmax(0, 1fr));
    }
    .stage {
      grid-template-columns: minmax(0, 1fr);
      align-content: start;
      gap: var(--space-3xs);
      min-height: 104px;
      padding: var(--space-xs);
    }
    .stage-n {
      margin-bottom: var(--space-2xs);
    }
    .stage-m {
      white-space: normal;
    }
    .wire {
      align-self: center;
      width: auto;
      height: 7px;
      margin: 0;
    }
    .wire::before {
      left: 0;
      right: 0;
      top: 3px;
      bottom: auto;
      width: auto;
      height: 1px;
    }
    .wire i {
      --travel: translateX(calc(var(--wire-len) - 7px));
    }
  }

  /* Un paquete recorre el camino etapa por etapa, en bucle. Solo transform/opacity. */
  :global(.js) .wire i {
    animation: packet var(--cycle) linear infinite;
  }
  :global(.js) .stage-led {
    animation: arrive var(--cycle) linear infinite;
  }
  .stage:nth-of-type(2) .stage-led {
    animation-delay: calc(var(--hop) * 1);
  }
  .stage:nth-of-type(3) .stage-led {
    animation-delay: calc(var(--hop) * 2);
  }
  .stage:nth-of-type(4) .stage-led {
    animation-delay: calc(var(--hop) * 3);
  }
  .stage:nth-of-type(5) .stage-led {
    animation-delay: calc(var(--hop) * 4);
  }
  .wire:nth-of-type(1) i {
    animation-delay: calc(var(--hop) * 0 + 0.12s);
  }
  .wire:nth-of-type(2) i {
    animation-delay: calc(var(--hop) * 1 + 0.12s);
  }
  .wire:nth-of-type(3) i {
    animation-delay: calc(var(--hop) * 2 + 0.12s);
  }
  .wire:nth-of-type(4) i {
    animation-delay: calc(var(--hop) * 3 + 0.12s);
  }
  @keyframes packet {
    0% {
      opacity: 0;
      transform: none;
    }
    1.5% {
      opacity: 1;
    }
    10% {
      opacity: 1;
      transform: var(--travel);
    }
    12%,
    100% {
      opacity: 0;
      transform: var(--travel);
    }
  }
  @keyframes arrive {
    0%,
    100% {
      opacity: 0.18;
    }
    2% {
      opacity: 1;
    }
    18% {
      opacity: 0.18;
    }
  }
  .flow:not(.is-visible) .wire i,
  .flow:not(.is-visible) .stage-led {
    animation-play-state: paused;
  }

  /* ---- ping real ---- */
  .ping {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2xs);
    margin-top: var(--space-xs);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--muted);
  }
  .ping b {
    font-weight: 500;
    color: var(--ion-ink);
  }

  /* ---- lectura de la etapa elegida ---- */
  .readout {
    position: relative;
    display: grid;
    gap: var(--space-s);
    margin-top: var(--space-xs);
    padding: var(--space-s) var(--space-s) var(--space-s) calc(var(--space-s) + 2px);
    border: 1px solid var(--line);
    background: var(--surface);
  }
  .readout::before {
    content: '';
    position: absolute;
    left: -1px;
    top: -1px;
    bottom: -1px;
    width: 2px;
    background: var(--volt-ink);
  }
  :global(.js) .readout {
    min-height: 6.5em;
  }
  :global(.js) .readout-item:not(.is-on) {
    display: none;
  }
  :global(.js) .readout-item.is-on {
    animation: readout-in var(--dur-3) var(--ease-out);
  }
  @keyframes readout-in {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
  }
  .readout-k {
    font-family: var(--font-display);
    font-size: var(--step--2);
    font-stretch: 87.5%;
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--muted);
  }
  .readout-k span {
    color: var(--volt-ink);
  }
  .readout-d {
    margin-top: var(--space-3xs);
    max-width: var(--w-text);
    color: var(--ink-2);
  }

  /* =================== caja de herramientas =================== */
  .toolbox {
    display: grid;
    gap: var(--space-xs);
    margin-top: var(--space-xl);
    padding-top: var(--space-m);
    border-top: 1px solid var(--line);
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.js) .wire i,
    :global(.js) .stage-led,
    .metric[data-idle] .spark-scan,
    :global(.js) .readout-item.is-on {
      animation: none;
    }
    .wire i {
      opacity: 0;
    }
    .stage-led {
      opacity: 0.4;
    }
    .metric[data-idle] .spark-scan {
      display: none;
    }
    .gauge span {
      transition: none;
    }
  }
</style>
