---
import { Image } from 'astro:assets';
import photo from '../assets/marlon.jpg';
import type { Lang } from '../i18n/content';
import { dict } from '../i18n/content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = dict[lang];
const years = new Date().getFullYear() - 2022;
---

<section class="hero" id="about">
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <p class="eyebrow mono">
        <span class="led is-pulse" data-hero-led></span>
        <span data-hero-status>{t.hero.role}</span>
      </p>
      <h1 class="name">{t.name}</h1>
      <p class="title">{t.hero.title}</p>
      <p class="lead">{t.hero.lead}</p>

      <div class="cta">
        <a class="btn" href="#contact">{t.hero.ctaPrimary} <span class="arrow" aria-hidden="true">→</span></a>
        <a class="btn btn-ghost" href="#system">{t.hero.ctaSecondary}</a>
      </div>

      <dl class="facts">
        <div>
          <dt class="mono">{t.hero.now}</dt>
          <dd>{t.hero.nowValue}</dd>
        </div>
        <div>
          <dt class="mono">{t.hero.based}</dt>
          <dd>{t.location}</dd>
        </div>
        <div>
          <dt class="mono">exp</dt>
          <dd><span class="num">{years}+</span> {t.hero.years}</dd>
        </div>
      </dl>
    </div>

    <figure class="portrait">
      <div class="frame">
        <Image
          src={photo}
          alt={t.fullName}
          widths={[240, 360, 560]}
          sizes="(max-width: 760px) 70vw, 340px"
          quality={70}
          format="webp"
          loading="eager"
          fetchpriority="high"
        />
        <span class="tick tl" aria-hidden="true"></span>
        <span class="tick tr" aria-hidden="true"></span>
        <span class="tick bl" aria-hidden="true"></span>
        <span class="tick br" aria-hidden="true"></span>
      </div>
      <figcaption class="mono">{t.hero.figure}</figcaption>
    </figure>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding: clamp(48px, 9vw, 112px) 0 clamp(56px, 9vw, 104px);
    overflow: hidden;
  }
  /* Rejilla tenue tipo papel milimetrado, solo detrás del hero. */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: linear-gradient(var(--grid) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid) 1px, transparent 1px);
    background-size: 32px 32px;
    mask-image: radial-gradient(ellipse 80% 70% at 70% 40%, #000 30%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse 80% 70% at 70% 40%, #000 30%, transparent 75%);
    pointer-events: none;
  }
  .hero-grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 340px;
    gap: clamp(32px, 6vw, 88px);
    align-items: center;
  }
  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 13px;
    color: var(--ink-2);
    margin-bottom: 20px;
  }
  .name {
    font-size: clamp(44px, 7.2vw, 84px);
    letter-spacing: -0.035em;
    line-height: 0.98;
  }
  .title {
    margin-top: 14px;
    font: 400 clamp(18px, 2.2vw, 22px) / 1.3 var(--font-mono);
    color: var(--accent-ink);
    letter-spacing: -0.01em;
  }
  .lead {
    margin-top: 24px;
    max-width: 58ch;
    font-size: clamp(16px, 1.6vw, 18px);
    color: var(--ink-2);
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 32px;
  }
  .facts {
    display: grid;
    grid-template-columns: repeat(3, auto);
    justify-content: start;
    gap: 12px 40px;
    margin: 44px 0 0;
    padding-top: 20px;
    border-top: 1px solid var(--line);
  }
  .facts dt {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
  }
  .facts dd {
    margin: 4px 0 0;
    font-size: 14px;
    color: var(--ink);
  }
  .num {
    font-family: var(--font-mono);
    font-weight: 500;
  }
  .portrait {
    margin: 0;
    justify-self: end;
    width: 100%;
  }
  .frame {
    position: relative;
    padding: 10px;
    border: 1px solid var(--line);
    background: var(--surface);
  }
  .frame :global(img) {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    filter: saturate(0.92) contrast(1.02);
  }
  .tick {
    position: absolute;
    width: 9px;
    height: 9px;
    border-color: var(--accent);
    border-style: solid;
    border-width: 0;
  }
  .tl {
    top: -1px;
    left: -1px;
    border-top-width: 1px;
    border-left-width: 1px;
  }
  .tr {
    top: -1px;
    right: -1px;
    border-top-width: 1px;
    border-right-width: 1px;
  }
  .bl {
    bottom: -1px;
    left: -1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
  }
  .br {
    bottom: -1px;
    right: -1px;
    border-bottom-width: 1px;
    border-right-width: 1px;
  }
  figcaption {
    margin-top: 10px;
    font-size: 11px;
    color: var(--muted);
    letter-spacing: 0.02em;
  }
  @media (max-width: 860px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
    .portrait {
      order: -1;
      justify-self: start;
      max-width: 168px;
    }
  }
  @media (max-width: 520px) {
    .facts {
      grid-template-columns: 1fr 1fr;
      gap: 16px 24px;
    }
    .facts div:last-child {
      grid-column: 1 / -1;
    }
  }
</style>
