---
// Hero: primera impresión. Presentación + retrato recortado + terminal integrada + canales (5 frentes).
// Móvil primero: en teléfonos el retrato va junto al nombre y la terminal debajo del texto;
// desde 1024 px, texto a la izquierda y retrato con la terminal encima a la derecha.
import type { Lang } from '../i18n';
import { careerStart, dict } from '../i18n';
import { yearsSince } from '../lib/time';
import Portrait from './hero/Portrait.astro';
import TerminalWindow from './hero/TerminalWindow.astro';
import Channels from './hero/Channels.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = dict[lang];
// Años completos desde el inicio de carrera; el cliente los recalcula (data-since).
const years = yearsSince(careerStart);
// Lead en dos partes: en teléfonos solo se ve la primera frase (la segunda repite "Ahora").
const [leadA, leadB] = (() => {
  const i = t.hero.lead.indexOf('. ');
  return i < 0 ? [t.hero.lead, ''] : [t.hero.lead.slice(0, i + 1), t.hero.lead.slice(i + 2)];
})();
---

<section class="hero" id="about">
  <div class="wrap hero__grid">
    <div class="hero__intro">
      <p class="hero__eyebrow eyebrow"><span class="xmark" aria-hidden="true"></span>{t.hero.kicker}</p>
      <h1 class="hero__name">{t.name}</h1>
      <p class="hero__headline">{t.hero.headline}</p>
      <p class="hero__lead">{leadA}{leadB && <span class="hero__lead-more"> {leadB}</span>}</p>
      <div class="hero__cta">
        <a class="btn" href="#contact" data-magnetic>{t.hero.ctaPrimary} <span class="arrow" aria-hidden="true">→</span></a>
        <a class="btn btn--ghost" href="#work" data-magnetic>{t.hero.ctaSecondary}</a>
        <button class="hero__try" type="button" data-terminal-focus data-js-only>
          {t.hero.terminalCta} <kbd aria-hidden="true">/</kbd>
        </button>
      </div>
      <dl class="hero__facts">
        <div>
          <dt class="label">{t.hero.now}</dt>
          <dd>{t.hero.nowValue}</dd>
        </div>
        <div>
          <dt class="label">{t.hero.based}</dt>
          <dd>{t.location}</dd>
        </div>
        <div>
          <dt class="label">{t.hero.exp}</dt>
          <dd><span class="num" data-since={careerStart}>{years}</span>+ {t.hero.years}</dd>
        </div>
      </dl>
    </div>

    <div class="hero__visual">
      <div class="hero__photo"><Portrait lang={lang} /></div>
      <div class="hero__term"><TerminalWindow lang={lang} /></div>
    </div>

    <div class="hero__channels"><Channels lang={lang} /></div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding: clamp(20px, 5vw, 64px) 0 clamp(40px, 7vw, 88px);
  }
  /* Móvil: intro y visual se "disuelven" en una sola rejilla para intercalar foto y terminal. */
  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 44%);
    grid-template-areas:
      'eyebrow eyebrow'
      'name photo'
      'headline headline'
      'lead lead'
      'cta cta'
      'term term'
      'channels channels'
      'facts facts';
    column-gap: 12px;
  }
  .hero__intro,
  .hero__visual {
    display: contents;
  }
  .hero__eyebrow {
    grid-area: eyebrow;
    gap: 10px;
    margin-bottom: 8px;
    color: var(--ink-2);
    font-size: var(--step--2);
    letter-spacing: 0.02em;
  }
  .hero__name {
    grid-area: name;
    align-self: end;
    padding-bottom: 14%;
    font-size: clamp(2.6rem, 9vw + 0.6rem, 5.5rem);
    font-weight: 600;
    font-stretch: 75%;
    letter-spacing: -0.05em;
    line-height: 0.95;
    text-wrap: balance;
  }
  .hero__photo {
    grid-area: photo;
    align-self: end;
  }
  .hero__headline {
    grid-area: headline;
    margin-top: 18px;
    max-width: 26ch;
    font: 500 var(--step-2) / 1.22 var(--font-display);
    font-stretch: 87.5%;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }
  .hero__lead {
    grid-area: lead;
    margin-top: 14px;
    max-width: 60ch;
    color: var(--ink-2);
    font-size: var(--step-0);
    line-height: 1.55;
  }
  .hero__cta {
    grid-area: cta;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin-top: 22px;
  }
  .hero__try {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 4px;
    border: 0;
    background: none;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    cursor: pointer;
  }
  .hero__try:hover {
    color: var(--ion-ink);
  }
  @media (pointer: coarse) {
    .hero__try kbd {
      display: none;
    }
  }
  /* Teléfonos: la terminal está justo debajo, así que el atajo sobra; los dos botones caben en una fila. */
  @media (max-width: 767.98px) {
    .hero__try {
      display: none;
    }
    .hero__cta {
      gap: 8px;
    }
    .hero__cta .btn {
      flex: 1 1 auto;
      padding-inline: 14px;
    }
  }
  .hero__term {
    grid-area: term;
    min-width: 0;
    margin-top: 24px;
    --term-h: 236px;
  }
  .hero__channels {
    grid-area: channels;
    margin-top: 32px;
  }
  .hero__facts {
    grid-area: facts;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 14px 24px;
    margin: 28px 0 0;
    padding-top: 16px;
    border-top: 1px solid var(--line);
  }
  .hero__facts div:first-child {
    grid-column: 1 / -1;
  }
  .hero__facts dd {
    margin: 4px 0 0;
    color: var(--ink);
    font-size: 14px;
  }
  .num {
    font-family: var(--font-mono);
    font-weight: 500;
  }

  /* Teléfonos: jerarquía con aire entre bloques; la terminal llega plegada en una barra. */
  @media (max-width: 767.98px) {
    .hero {
      padding-block: 28px 32px;
    }
    .hero__headline {
      margin-top: 28px;
    }
    .hero__lead {
      margin-top: 12px;
    }
    .hero__lead-more {
      display: none;
    }
    .hero__cta {
      margin-top: 28px;
    }
    .hero__term {
      margin-top: 40px;
    }
    .hero__channels {
      margin-top: 40px;
    }
    .hero__facts {
      margin-top: 32px;
    }
  }

  @media (min-width: 768px) {
    .hero__grid {
      grid-template-columns: minmax(0, 1fr) 300px;
      column-gap: 32px;
    }
    .hero__term {
      --term-h: 220px;
    }
    .hero__facts {
      grid-template-columns: repeat(3, auto);
      justify-content: start;
      column-gap: 40px;
    }
    .hero__facts div:first-child {
      grid-column: auto;
    }
  }

  /* Escritorio: dos columnas; la terminal se monta sobre el pecho del retrato y sangra hacia el texto. */
  @media (min-width: 1024px) {
    .hero__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.82fr);
      grid-template-areas:
        'intro visual'
        'channels channels';
      column-gap: clamp(32px, 4vw, 64px);
      align-items: start;
    }
    .hero__intro {
      grid-area: intro;
      display: block;
      padding-top: clamp(8px, 3vw, 48px);
    }
    .hero__visual {
      grid-area: visual;
      display: grid;
      grid-template-columns: minmax(0, 1fr);
    }
    .hero__name {
      padding-bottom: 0;
    }
    .hero__photo,
    .hero__term {
      grid-area: auto;
      min-width: 0;
    }
    .hero__photo {
      width: min(100%, 440px);
      justify-self: end;
    }
    .hero__term {
      position: relative;
      z-index: 2;
      margin: -30% 0 0 -8%;
      --term-h: 220px;
    }
    .hero__channels {
      margin-top: clamp(40px, 5vw, 72px);
    }
    .hero__facts {
      margin-top: 36px;
    }
  }
</style>
