---
import type { Lang } from '../i18n/content';
import { dict } from '../i18n/content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = dict[lang];

// Datos para los comandos. Bloque JSON (no ejecutable): la CSP no lo afecta.
const data = {
  lang,
  name: t.name,
  fullName: t.fullName,
  role: t.hero.title,
  lead: t.hero.lead,
  location: t.location,
  email: t.email,
  linkedin: t.linkedin,
  github: t.github,
  jobs: t.jobs.map((j) => ({ id: j.id, company: j.company, role: j.role, from: j.from, to: j.to, summary: j.summary })),
  projects: t.projects.items.map((p) => ({ name: p.name, kicker: p.kicker, summary: p.summary, stack: p.stack })),
  skills: t.skills.groups.map((g) => ({ k: g.k, v: g.v })),
  edu: t.skills.edu.map((e) => `${e.t} · ${e.s}`),
  welcome: t.terminal.welcome,
  notFound: t.terminal.notFound,
};
const json = JSON.stringify(data).replace(/</g, '\\u003c');
---

<dialog class="term" data-terminal aria-label={t.terminal.title}>
  <div class="term-win">
    <div class="term-bar mono">
      <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
      <span class="term-title">visitor@marlon.mihomeserver.com: ~</span>
      <button class="term-x" type="button" data-terminal-close aria-label={t.ui.close}>esc</button>
    </div>
    <div class="term-out mono" data-terminal-out role="log" aria-live="polite"></div>
    <form class="term-line mono" data-terminal-form autocomplete="off">
      <label class="prompt" for="term-in"><span class="u">visitor</span>@<span class="h">homelab</span>:<span class="p">~</span>$</label>
      <input
        id="term-in"
        class="term-in"
        data-terminal-in
        type="text"
        spellcheck="false"
        autocapitalize="off"
        autocomplete="off"
        maxlength="120"
        enterkeyhint="send"
      />
    </form>
  </div>
</dialog>
<script type="application/json" id="term-data" is:inline set:html={json} />

<style>
  .term {
    width: min(860px, calc(100vw - 24px));
    max-height: min(620px, calc(100dvh - 48px));
    padding: 0;
    border: 1px solid #ffffff1a;
    border-radius: 6px;
    background: var(--term-bg);
    color: var(--term-ink);
    box-shadow: 0 30px 80px -20px #000000b0;
    overflow: hidden;
  }
  .term::backdrop {
    background: #0b0c0ecc;
    backdrop-filter: blur(3px);
  }
  .term[open] {
    animation: pop 0.18s ease-out;
  }
  @keyframes pop {
    from {
      opacity: 0;
      transform: translateY(8px) scale(0.99);
    }
  }
  .term-win {
    display: flex;
    flex-direction: column;
    height: min(620px, calc(100dvh - 48px));
  }
  .term-bar {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 10px 14px;
    font-size: 12px;
    color: #8c919b;
    border-bottom: 1px solid #ffffff12;
  }
  .dots {
    display: inline-flex;
    gap: 6px;
  }
  .dots i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #ffffff22;
  }
  .term-title {
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .term-x {
    padding: 2px 8px;
    border: 1px solid #ffffff22;
    border-radius: 3px;
    background: none;
    color: #8c919b;
    font: inherit;
    cursor: pointer;
  }
  .term-x:hover {
    color: #e8e6e1;
  }
  .term-out {
    flex: 1;
    overflow-y: auto;
    padding: 14px 16px 4px;
    font-size: 13px;
    line-height: 1.6;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    scrollbar-color: #ffffff26 transparent;
    scrollbar-width: thin;
  }
  .term-line {
    display: flex;
    gap: 8px;
    padding: 4px 16px 16px;
    font-size: 13px;
  }
  .prompt {
    white-space: nowrap;
    color: #8c919b;
  }
  .u {
    color: #4ac26b;
  }
  .h {
    color: #f08a4b;
  }
  .p {
    color: #7aa2f7;
  }
  .term-in {
    flex: 1;
    min-width: 0;
    padding: 0;
    border: 0;
    outline: 0;
    background: transparent;
    color: #e8e6e1;
    font: inherit;
    caret-color: #f08a4b;
  }
  .term-out :global(.c-cmd) {
    color: #e8e6e1;
  }
  .term-out :global(.c-dim) {
    color: #6c717b;
  }
  .term-out :global(.c-acc) {
    color: #f08a4b;
  }
  .term-out :global(.c-ok) {
    color: #4ac26b;
  }
  .term-out :global(.c-warn) {
    color: #d6a33a;
  }
  .term-out :global(.c-err) {
    color: #f7768e;
  }
  .term-out :global(.c-blue) {
    color: #7aa2f7;
  }
  .term-out :global(a) {
    color: #7aa2f7;
  }
  @media (max-width: 520px) {
    .prompt .h,
    .prompt .u {
      display: none;
    }
  }
</style>
