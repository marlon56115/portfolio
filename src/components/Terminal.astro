---
// Datos de la terminal. Home.astro lo renderiza al final de la página; la ventana de la
// terminal vive en el hero (src/components/hero/TerminalWindow.astro). Aquí solo queda el bloque JSON
// (no ejecutable: la CSP no lo afecta; `<` escapado).
import type { Lang } from '../i18n';
import { careerStart, dict } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = dict[lang];

// Lectura defensiva: otras secciones pueden cambiar la forma de sus datos.
const data = {
  lang,
  name: t.name,
  fullName: t.fullName,
  role: t.hero.title,
  lead: t.hero.lead,
  now: t.hero.nowValue,
  location: t.location,
  email: t.email,
  linkedin: t.linkedin,
  github: t.github,
  careerStart,
  caps: t.hero.capabilities.map((c) => ({ k: c.k, t: c.t, d: c.d, tools: c.tools })),
  jobs: (t.jobs ?? []).map((j) => ({ id: j.id, company: j.company, role: j.role, from: j.from, to: j.to, summary: j.summary })),
  projects: (t.projects?.items ?? []).map((p) => ({ name: p.name, kicker: p.kicker, summary: p.summary, stack: p.stack ?? [] })),
  skills: (t.skills?.groups ?? []).map((g) => ({ k: g.k, v: g.v })),
  edu: (t.skills?.edu ?? []).map((e) => `${e.t} · ${e.s}`),
};
const json = JSON.stringify(data).replace(/</g, '\\u003c');
---

<script type="application/json" id="term-data" is:inline set:html={json} />
